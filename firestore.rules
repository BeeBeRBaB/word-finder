rules_version = '2';

// Paste into Firebase console > Firestore > Rules. Each player owns users/{their uid};
// nothing else is readable or writable. Written by src/cloud.js save().
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // `data` is the progress JSON; the 200 KB cap matches MAX_DATA in src/cloud.js.
    function isValidSave(d) {
      return d.keys().hasAll(['data'])
        && d.keys().hasOnly(['data', 'level', 'points', 'updated'])
        && d.data is string && d.data.size() < 200000
        && (!('level' in d) || d.level is int)
        && (!('points' in d) || d.points is int)
        && (!('updated' in d) || d.updated is timestamp);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidSave(request.resource.data);
    }
  }
}
