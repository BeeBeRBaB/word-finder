.playwright-mcp/
.superpowers/
node_modules/
test-results/
playwright-report/
.shots/

# Agent and tool scratch must never be committed: an 85KB screenshot and a
# 602-line JSON dump once rode in on a git add -A. Root .png/.json is denied by
# default and every file that genuinely belongs there is listed back in.
/*.png
/*.json
!/icon-192.png
!/icon-512.png
!/package-lock.json
!/package.json
!/tsconfig.json
